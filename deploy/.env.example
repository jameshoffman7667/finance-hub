# Finance Hub environment (names only; real values live in the server .env, never in git)

# --- required ---
# At least 32 characters. Encrypts stored secrets (authenticator seeds, later API keys). Losing it makes those unreadable.
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=

# --- host wiring (set in the stack's .env) ---
# Host port assigned from the server port register. Container port is 8080.
PORT_HOST=
# Storage roots (defaults match the server template)
# FAST_STORAGE=/srv/dev-disk-by-uuid-758425e9-f9ca-4fbc-ad81-eaea80fdfb73/appdata-ssd
# SLOW_STORAGE=/srv/mergerfs/StoragePool/docker

# --- public address ---
# Full https address, used to accept same-origin requests behind the proxy.
APP_URL=https://finance-hub.hoffmanhouse.ca
# Keep true behind Cloudflare. The app itself speaks plain HTTP.
COOKIE_SECURE=true

# --- optional: Cloudflare Access (recommended before using from outside the house) ---
# When both are set, every /api request must carry a valid Cloudflare Access JWT for this audience.
# Team domain looks like yourteam.cloudflareaccess.com. The AUD tag is on the Access application page.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- optional ---
# Create the first user from the environment instead of the first-run screen (hash made with argon2id).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Signed-in sessions end after this many idle minutes.
SESSION_IDLE_MINUTES=30
# Largest statement upload, in MB (Cloudflare caps request bodies at 100 MB).
MAX_UPLOAD_MB=50
# Which proxies may set X-Forwarded-* headers (default: private/Docker networks only).
TRUST_PROXY=loopback, linklocal, uniquelocal
# error | warn | info | debug
LOG_LEVEL=info
